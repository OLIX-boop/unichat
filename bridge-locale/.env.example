# ---------------------------------------------------------------------------
# Bridge locale UniChat - copia questo file in .env e riempilo.
# Il file .env NON deve mai finire su git (vedi .gitignore in root).
# ---------------------------------------------------------------------------

# --- Istanza WAHA (WhatsApp HTTP API) gia' in esecuzione e autenticata ---
# Se WAHA gira nello stesso container del bridge, lascia 127.0.0.1.
WAHA_BASE_URL=http://127.0.0.1:3000
WAHA_API_KEY=la-tua-api-key-waha
# Nome della sessione WAHA ("default" se non l'hai cambiato)
WAHA_SESSION=default

# --- Chat ---
# Gruppi da monitorare, separati da virgola. Ogni voce e' <chat_id> oppure
# <chat_id>=<etichetta>: l'etichetta compare nel digest e nella dashboard, utile
# quando i gruppi sono piu' di uno.
#   SOURCE_CHAT_IDS=1203...@g.us=Informatica,1204...@g.us=Elettronica
SOURCE_CHAT_IDS=123456789012345678@g.us=Nome del gruppo
# Destinazione del digest. Lasciandolo vuoto il bridge usa la chat
# "Messaggi a te stesso", risolvendo l'account dalla sessione WAHA.
DIGEST_CHAT_ID=

# --- Sicurezza ---
# Chiave condivisa con il Cloudflare Worker, inviata nell'header X-Bridge-Key.
# Generala tu, ad esempio con:  openssl rand -hex 32
BRIDGE_API_KEY=genera-una-chiave-lunga-e-casuale

# --- Modalita' push (quando NON si usa il Cloudflare Tunnel) ---
# Endpoint /ingest del Worker: e' il server a chiamare Cloudflare, quindi non
# serve ne' un dominio ne' una porta aperta. Lasciandolo vuoto la modalita'
# push e' disattivata (si usa il Cron Trigger di Cloudflare via Tunnel).
WORKER_INGEST_URL=https://unichat-worker.tuo-account.workers.dev/ingest
# Come il runner raggiunge il bridge: sempre e solo loopback.
BRIDGE_SELF_URL=http://127.0.0.1:8088
PUSH_STATE_PATH=./data/push_state.json
# Quanto storico leggere al primo giro, quando non c'e' ancora un watermark.
PUSH_FIRST_RUN_LOOKBACK_HOURS=24
PUSH_TIMEOUT_SECONDS=120

# --- Interni ---
CURSOR_DB_PATH=./data/cursor.sqlite3
MAX_MESSAGES_PER_REQUEST=200
REQUEST_TIMEOUT_SECONDS=30
# Giorni di conservazione degli id gia' consegnati (anti-duplicati)
SEEN_RETENTION_DAYS=14
