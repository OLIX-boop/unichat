# Installazione:
#   sudo cp deploy/unichat-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now unichat-bridge
# Adatta User/WorkingDirectory al tuo percorso reale prima di copiarlo.

[Unit]
Description=UniChat bridge (FastAPI -> WAHA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=unichat
Group=unichat
WorkingDirectory=/opt/unichat/bridge-locale
EnvironmentFile=/opt/unichat/bridge-locale/.env
ExecStart=/opt/unichat/bridge-locale/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8088
Restart=on-failure
RestartSec=5

# Il bridge ascolta solo su loopback: l'unico accesso dall'esterno e' il Tunnel.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
